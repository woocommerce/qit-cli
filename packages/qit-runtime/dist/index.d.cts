/**
 * Execute commands inside QIT Docker containers.
 *
 * Needs Docker tier: throws if QIT_PHP_CONTAINER is not set.
 */
/**
 * Execute a WP-CLI command inside the PHP container.
 *
 * @param command - The WP-CLI command without the leading `wp` (e.g., `'plugin list --format=json'`).
 * @returns stdout trimmed.
 */
declare function wp(command: string): Promise<string>;
/**
 * Execute an arbitrary command inside the PHP container.
 *
 * @param command - The shell command to run.
 * @returns stdout trimmed.
 */
declare function exec(command: string): Promise<string>;

/**
 * Anonymous capability discovery via named actions.
 *
 * Like WordPress do_action() — multiple packages can register implementations
 * for the same action name. Consumers iterate over all registered actions.
 *
 * Reads the actions manifest (generated by QIT CLI) and lazily loads
 * action modules. Each action is the `export default` from a file,
 * with `.provider` metadata attached (which package registered it).
 *
 * Always available: returns [] if no manifest is set.
 */
/** An action function with metadata about which package registered it. */
interface ActionFunction {
    /** The function itself (callable). */
    (...args: any[]): any;
    /** Package identifier that registered this action, e.g. 'stripe/payments'. */
    provider: string;
}
/**
 * Get all registered actions for a named capability.
 *
 * Returns [] if no actions are registered for the given name.
 * This is by design: zero actions = zero test cases, not an error.
 */
declare function actions(name: string): ActionFunction[];
/**
 * Check whether at least one action is registered for a capability.
 */
declare function hasAction(name: string): boolean;

/**
 * Known dependency access.
 *
 * Reads the package map (generated by QIT CLI) and lazily require()s
 * each package's entry point. Returns whatever the package exports.
 *
 * Always available: throws if the requested package is not in the map.
 */
/**
 * Load a test/utility package's exports by name.
 *
 * Uses standard Node.js module resolution on the package's directory
 * (resolves via package.json main/exports or index.ts convention).
 *
 * @param name - Package identifier, e.g. 'woocommerce/core-utils'.
 * @returns The package's module exports.
 * @throws If the package is not in the current environment's package map.
 */
declare function loadPackage(name: string): Record<string, any>;

/**
 * Generic async condition polling.
 *
 * Always available — no QIT env vars needed.
 */
/**
 * Wait for a condition to become true, polling at a fixed interval.
 *
 * @param condition - Function that returns true (or resolves to true) when the condition is met.
 * @param timeout - Maximum time to wait in milliseconds. Default: 30000.
 * @param interval - Polling interval in milliseconds. Default: 1000.
 * @throws If the timeout is reached before the condition is met.
 */
declare function waitFor(condition: () => boolean | Promise<boolean>, timeout?: number, interval?: number): Promise<void>;

/**
 * @woocommerce/qit-runtime — QIT runtime for test packages.
 *
 * Two access patterns:
 *   qit.actions('makePurchase')             — anonymous capability discovery (cumulative)
 *   qit.package('woocommerce/core-utils')   — known dependency access (singular)
 *
 * Three availability tiers:
 *   Always available:  env.isQit, actions(), hasAction(), package(), waitFor(), version
 *   Needs env vars:    env.siteUrl, env.db.*, env.sut.*, etc.
 *   Needs Docker:      wp(), exec()
 */

declare const qit: {
    env: {
        readonly isQit: boolean;
        readonly id: string;
        readonly siteUrl: string;
        readonly adminUrl: string;
        readonly baseUrl: string;
        db: {
            readonly host: string;
            readonly name: string;
            readonly user: string;
            readonly password: string;
        };
        wp: {
            readonly username: string;
            readonly password: string;
        };
        containers: {
            readonly php: string;
            readonly db: string;
        };
        sut: {
            readonly slug: string;
            readonly type: string;
            readonly entrypoint: string;
        };
        versions: {
            readonly wp: string;
            readonly woo: string;
            readonly php: string;
        };
        plugins: {
            readonly active: string[];
            readonly additional: string[];
        };
        themes: {
            readonly additional: string[];
        };
        readonly testPackages: string[];
    };
    wp: typeof wp;
    exec: typeof exec;
    actions: typeof actions;
    hasAction: typeof hasAction;
    package: typeof loadPackage;
    waitFor: typeof waitFor;
    version: string;
};

export { type ActionFunction, qit as default, qit };
