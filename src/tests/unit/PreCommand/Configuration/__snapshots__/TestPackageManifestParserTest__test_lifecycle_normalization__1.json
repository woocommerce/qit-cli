{
    "$schema": "https:\/\/qit.woo.com\/json-schema\/test-package",
    "test_type": "unit",
    "lifecycle": {
        "test": {
            "setup": [
                "composer install",
                {
                    "command": ".\/scripts\/setup.sh",
                    "runs_on": "host"
                },
                {
                    "command": "npm test",
                    "continue_on_error": true
                }
            ],
            "run": [
                "phpunit"
            ]
        }
    }
}
