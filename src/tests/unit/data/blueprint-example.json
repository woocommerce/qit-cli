{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/edit.php?post_type=product",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"plugins": [ "woocommerce" ],
	"siteOptions": {
		"blogname": "Blueprint Store"
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "hello-dolly"
			},
			"options": { "activate": false }
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "storefront"
			},
			"options": { "activate": true }
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true
			}
		},
		{
			"step": "wp-cli",
			"command": "wp option update woocommerce_store_country US:CA"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once 'wp-load.php'; wp_insert_post( [ 'post_title' => 'From the Blueprint', 'post_status' => 'publish' ] );"
		},
		{
			"step": "enableMultisite"
		}
	]
}
