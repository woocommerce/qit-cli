{
  "require": {
    "php": "^8.4",
    "cweagans/composer-patches": "^1"
  },
  "autoload": {
    "psr-4": {
      "QIT\\IntegrationTests\\": ["tests", "./"]
    },
    "files": [
      "QITTestExtension.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^12",
    "spatie/phpunit-snapshot-assertions": "^5.0",
    "symfony/process": "^7",
    "symfony/filesystem": "^7",
    "vlucas/phpdotenv": "^5",
    "brianium/paratest": "^7"
  },
  "extra": {
    "patches": {
      "brianium/paratest": {
        "Fix --stop-on-failure to kill workers, add 5-min per-test timeout": "patches/paratest-stop-on-failure-timeout.patch"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  }
}
