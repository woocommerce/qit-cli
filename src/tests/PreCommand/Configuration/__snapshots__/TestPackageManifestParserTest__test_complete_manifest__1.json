{
    "$schema": "https:\/\/qit.woo.com\/json-schema\/test-package",
    "test_type": "e2e",
    "test_dir": ".\/tests",
    "description": "Comprehensive E2E tests for checkout flow",
    "tags": [
        "checkout",
        "payments",
        "critical"
    ],
    "requires": {
        "plugins": {
            "woocommerce": "^8.0.0",
            "woocommerce-payments": ">=5.0.0"
        },
        "themes": {
            "storefront": "*"
        },
        "wordpress": ">=6.0",
        "php": ">=7.4",
        "secrets": [
            "STRIPE_API_KEY",
            "PAYPAL_CLIENT_ID"
        ],
        "external_services": [
            "Stripe API",
            "PayPal Sandbox"
        ]
    },
    "lifecycle": {
        "environment": {
            "setup": [
                "composer install",
                {
                    "command": "npm install",
                    "timeout": 300
                }
            ],
            "teardown": [
                ".\/cleanup.sh"
            ]
        },
        "test": {
            "setup": [
                "npm run build"
            ],
            "run": [
                {
                    "command": "npm test",
                    "env": {
                        "NODE_ENV": "test"
                    }
                }
            ],
            "teardown": [
                "rm -rf test-artifacts"
            ]
        }
    },
    "test_results": {
        "junit": ".\/results\/junit.xml",
        "json": ".\/results\/test-results.json"
    },
    "mu_plugins": [
        ".\/mu-plugins\/test-helper.php",
        ".\/mu-plugins\/mock-payments.php"
    ],
    "env_vars": {
        "WP_DEBUG": "true",
        "SCRIPT_DEBUG": "false",
        "TEST_TIMEOUT": "30000",
        "ENVIRONMENT": "testing"
    },
    "timeout": 1800,
    "retry": {
        "times": 3,
        "delay": 10
    }
}
