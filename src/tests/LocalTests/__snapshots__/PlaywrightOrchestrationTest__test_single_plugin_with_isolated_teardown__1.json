[
    {
        "name": "[test] Test Slug (Run)",
        "testDir": "test-path-in-php-container",
        "testMatch": "**\/*.spec.js",
        "dependencies": [],
        "use": {
            "browserName": "chromium",
            "qitTestSlug": "test-slug"
        }
    },
    {
        "name": "[teardown] Test Slug (Shell)",
        "testDir": "\/qit\/tests\/e2e\/scripts",
        "testMatch": "bash.js",
        "dependencies": [
            "[test] Test Slug (Run)"
        ],
        "retries": 0,
        "use": {
            "qitTestSlug": "test-slug",
            "type": "Isolated Teardown for test-slug (Bash)",
            "file": "test-path-in-php-container\/bootstrap\/teardown.sh"
        }
    },
    {
        "name": "[teardown] Test Slug (JS)",
        "testDir": "test-path-in-php-container\/bootstrap",
        "testMatch": "teardown.js",
        "dependencies": [
            "[teardown] Test Slug (Shell)"
        ],
        "use": {
            "browserName": "chromium",
            "qitTestSlug": "test-slug"
        }
    }
]
