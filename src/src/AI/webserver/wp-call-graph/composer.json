{
    "name": "yourname/wp-call-graph",
    "description": "Generate call graphs for PHP and WordPress code, including action/filter hooks",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "nikic/php-parser": "^4.0 || ^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "CallGraph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CallGraph\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/wp-call-graph"
    ],
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}
