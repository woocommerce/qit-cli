{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt With Tools Request",
  "type": "object",
  "required": ["job_id", "type", "messages", "model", "callback_url"],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique identifier for the job"
    },
    "type": {
      "type": "string",
      "enum": ["prompt-with-tools"],
      "description": "Request type identifier"
    },
    "messages": {
      "type": "array",
      "description": "Array of chat messages",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"],
            "description": "Message role"
          },
          "content": {
            "type": "string",
            "description": "Message content"
          }
        }
      }
    },
    "model": {
      "type": "string",
      "description": "AI model to use for processing"
    },
    "callback_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to send the response back to"
    },
    "extract_path": {
      "type": "string",
      "description": "Path to extracted files for tool operations"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier for workspace context"
    },
    "format": {
      "type": "string",
      "description": "Response format specification"
    },
    "max_iterations": {
      "type": "integer",
      "default": 12,
      "description": "Maximum number of tool iterations"
    },
    "min_tool_calls": {
      "type": "integer",
      "default": 2,
      "description": "Minimum number of tool calls required"
    }
  },
  "additionalProperties": false
}