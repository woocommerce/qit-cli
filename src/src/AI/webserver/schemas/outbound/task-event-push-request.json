{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Event Push Request",
  "type": "object",
  "required": ["state", "timestamp"],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["queued", "in_progress", "succeeded", "failed", "heartbeat"],
      "description": "Current state of the task"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 formatted timestamp of the event"
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Optional progress percentage (0-100)"
    },
    "payload": {
      "type": "object",
      "description": "Additional event data",
      "properties": {
        "result": {
          "description": "Task result data (for succeeded events)"
        }
      }
    }
  },
  "additionalProperties": false
}